<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9EE"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Sección del Título -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Patita izquierda"
            android:src="@drawable/ic_bear_paw" />

        <TextView
            android:id="@+id/tvTitleOsitos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:fontFamily="sans-serif-rounded"
            android:text="OSITOS"
            android:textColor="#EE8090"
            android:textSize="36sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Patita derecha"
            android:src="@drawable/ic_bear_paw" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTitleTicTacToe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:fontFamily="sans-serif-rounded"
        android:text="TIC TAC TOE"
        android:textColor="#92A8D1"
        android:textSize="32sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="32dp" />

    <!-- Botón 1: CONTINUAR -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinue"
        android:layout_width="240dp"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_pill"
        android:fontFamily="sans-serif-rounded"
        android:text="CONTINUAR"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Botón 2: VS CPU -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnVsCpu"
        android:layout_width="240dp"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_pill"
        android:fontFamily="sans-serif-rounded"
        android:text="JUGAR VS CPU"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Botón 3: 2 JUGADORES -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnVsHuman"
        android:layout_width="240dp"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_pill"
        android:fontFamily="sans-serif-rounded"
        android:text="2 JUGADORES"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Botón 4: JUGAR ONLINE -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnOnline"
        android:layout_width="240dp"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_pill"
        android:fontFamily="sans-serif-rounded"
        android:text="JUGAR ONLINE"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Botón 5: DIFICULTAD -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDifficulty"
        android:layout_width="240dp"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_pill"
        android:fontFamily="sans-serif-rounded"
        android:text="DIFICULTAD"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Botón 6: ACERCA DE -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAbout"
        android:layout_width="240dp"
        android:layout_height="50dp"
        android:background="@drawable/button_pill"
        android:fontFamily="sans-serif-rounded"
        android:text="ACERCA DE"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>