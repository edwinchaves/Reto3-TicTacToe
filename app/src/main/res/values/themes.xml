<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base sin ActionBar para evitar conflictos visuales e inicialización limpia -->
    <style name="Base.Theme.TicTacToe" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Colores base necesarios para evitar fallos de renderizado en Android -->
        <item name="colorPrimary">#7CA1D8</item>
        <item name="colorPrimaryDark">#5C82B8</item>
        <item name="colorAccent">#F28B82</item>
        <item name="android:windowBackground">#F5F5F5</item>
    </style>

    <style name="Theme.TicTacToe" parent="Base.Theme.TicTacToe" />

    <!-- Estilo para las casillas del tablero -->
    <style name="BoardSquareStyle">
        <item name="android:layout_width">90dp</item>
        <item name="android:layout_height">90dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">12dp</item>
        <item name="android:elevation">4dp</item>
    </style>

</resources>