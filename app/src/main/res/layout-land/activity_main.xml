<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9EE"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- COLUMNA IZQUIERDA: Estado del turno + Tablero -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-rounded"
            android:text="Turno: Jugador 1"
            android:textColor="#555555"
            android:textSize="14sp"
            android:textStyle="bold" />

        <co.edu.unal.tictactoe.BoardView
            android:id="@+id/boardView"
            android:layout_width="220dp"
            android:layout_height="220dp" />
    </LinearLayout>

    <Space
        android:layout_width="16dp"
        android:layout_height="match_parent" />

    <!-- COLUMNA DERECHA: Título + Código Sala Online + Marcador de Victorias -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Encabezado Título -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Patita izquierda"
                android:src="@drawable/ic_bear_paw" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:fontFamily="sans-serif-rounded"
                android:text="OSITOS"
                android:textColor="#EE8090"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Patita derecha"
                android:src="@drawable/ic_bear_paw" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-rounded"
            android:text="TIC TAC TOE"
            android:textColor="#92A8D1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Indicador de Código de Sala Online (Oculto por defecto en local) -->
        <TextView
            android:id="@+id/tvRoomId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-rounded"
            android:text="Sala: ------"
            android:textColor="#EE8090"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Panel de Victorias -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- Jugador 1 (Café) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Osito Café"
                    android:src="@drawable/ic_bear_human" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlayer1Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:text="JUGADOR 1"
                        android:textColor="#4A3228"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPlayer1Wins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:text="0 wins"
                        android:textColor="#7A6860"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Jugador 2 / CPU -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPlayer2Icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Icono Jugador 2 o Robot"
                    android:src="@drawable/ic_bear_human2" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlayer2Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:text="JUGADOR 2"
                        android:textColor="#4A3228"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPlayer2Wins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:text="0 wins"
                        android:textColor="#7A6860"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>